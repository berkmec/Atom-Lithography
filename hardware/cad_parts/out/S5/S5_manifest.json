  "reconciliations": {
    "S5.1-01": {
      "field": "UHV main chamber inner radius & volume",
      "bom_v7_spec": "r = 175 mm (~34 L, Exp80 s=0.5 envelope)",
      "cad_v8_adopted": "R_in = 182.0 mm, R_out = 192.0 mm, H_in = 335.5 mm, V_in = 34.91 L",
      "engineering_rationale": "Exp125 8-coil cryo-magnet outer former has OD = 352.0 mm (R = 176.0 mm). A BOM r = 175 mm wall would interfere by 1.0 mm; R_in = 182.0 mm provides 6.0 mm radial vacuum clearance (182 - 176 = 6.0 mm) while keeping V_in / V_ref = 34.91 / 269.39 = 0.1296 within Exp80 BC4 (1/8 +/- 5%)."
    },
    "S5.1-04": {
      "field": "Magnetically coupled UHV transfer arm linear stroke",
      "bom_v7_spec": "500 mm linear stroke + 360 deg rotary with Ti-6Al-4V wafer fork",
      "cad_v8_adopted": "Full 500.0 mm active stroke (540 mm magnetic guide tube, 635 mm total arm envelope along +X from X=510.5 to 1145.5 mm) replacing legacy CAD v6.0 200 mm stub.",
      "engineering_rationale": "Load-lock center (X=420 mm) to main chamber wafer chuck (X=0 mm) requires 420 mm travel plus 80 mm cassette pickup reserve = 500 mm minimum stroke. In Wave 2B v8 layout, 19-inch Rack Bay 1 moves to X=+1400 mm, leaving >250 mm service clearance behind the 500 mm transfer arm."
    },
    "S5.4-01": {
      "field": "28Si/29Si epitaxial wafer diameter",
      "bom_v7_spec": "25x Dia 100 mm stock epitaxial wafers (100 nm epi, f=1.0% 29Si)",
      "cad_v8_adopted": "Dia 50.0 mm x 0.775 mm laser-diced working wafer (SEMI M1 primary/secondary flats) seated at Z_WAFER = 500.00 mm on 80x80 mm AlN carrier.",
      "engineering_rationale": "An undiced Dia 100 mm wafer with carrier frame cannot fit inside the Dia 150.0 mm Exp125 magnet clear bore or pass through the CF100 load-lock gate valve bore (Dia 101.6 mm). Laser-dicing Dia 100 mm CVD stock to Dia 50.0 mm working wafers yields 80x80 mm carrier diagonal = 113.14 mm (18.43 mm radial clearance to Dia 150 mm bore)."
    }
  },
